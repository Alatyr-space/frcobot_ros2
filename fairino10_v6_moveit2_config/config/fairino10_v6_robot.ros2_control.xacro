<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="fairino10_v6_robot_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- The real arm's hardware interface, not a simulation. The component is named in the robot xacro; it was `FakeSystem` upstream (Alatyr F-159). -->
                <plugin>fairino_hardware/FairinoHardwareInterface</plugin>
                <!-- F-323: how long a -2 (ERR_SOCKET_COM_FAILED) on a state
                     read is held through, the last good state kept, before
                     the read fails and the arm is deactivated -->
                <param name="transient_read_error_tolerance_ms">100</param>
                <!-- Q-C1 (a): after a refused ServoJ, the driver sends the
                     measured position until the command is back within this
                     of it on every joint (rad); it only withholds motion -->
                <param name="resume_max_step_rad">0.01</param>
                <!-- The code-14 drill (bench row 0.F7) and the read-error
                     drill (row 0.F6, F-466): true, with
                     FAIRINO_HARDWARE_ALLOW_SERVOJ_REFUSAL_INJECTION=1 in the
                     Arm module's environment, offers ~/inject_servoj_refusal
                     (std_srvs/SetBool), ~/inject_read_errors_under and
                     ~/inject_read_errors_over (std_srvs/Trigger: the next 5
                     or 20 state reads return -2, under and over the 100 ms
                     bound) on the component's node. Refused to load without
                     the variable. Never true in a production run -->
                <param name="servoj_refusal_injection">false</param>
            </hardware>
            <joint name="j1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j1']}</param>
                </state_interface>
                <!-- F-204: the robot-measured speed. Without it every /joint_states
                     velocity is NaN, which MoveIt Servo takes in (F-184). -->
                <state_interface name="velocity"/>
                <!-- F-447: the robot-measured torque. Without it every
                     /joint_states effort is NaN, which pymoveit2 refuses. -->
                <state_interface name="effort"/>
            </joint>
            <joint name="j2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="j3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="j4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="j5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="j6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
